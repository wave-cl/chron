    "/v1/db/{db}/tail": {
      "get": {
        "summary": "Committed events from a position, then live ones, as server-sent events",
        "responses": {
          "200": {
            "description": "server-sent events: `data:` holds an Event; a final `event: error` carries an Error",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "an error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "db",
            "in": "path",
            "required": true,
            "description": "the database name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "start position (default 0)",
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "only events carrying this tag",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag_base64",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "a binary tag, base64, instead of tag"
          },
          {
            "name": "consistency",
            "in": "query",
            "required": false,
            "description": "local (everything the node holds) or confirmed (only positions a majority of the group durably holds); absent: the daemon's default (--read-consistency; confirmed when sync commits are in effect)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "follow through a durable cursor of this name (confirmed delivery from its stored position; --from applies to a new cursor); the first SSE item is then `event: session` with {\"session\", \"from\"}; leader only",
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": " The stream is text/event-stream: one data: line of JSON per event, a `: heartbeat` comment every 15 s, and a final event: error when the database is dropped, cut back to an earlier position (a diverged node resetting; its JSON carries position), the node fenced or the daemon stops."
      }
    },
