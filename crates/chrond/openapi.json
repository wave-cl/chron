    "/v1/members": {
      "get": {
        "summary": "The group's membership as this node holds it",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Members"
                }
              }
            }
          },
          "default": {
            "description": "an error",
