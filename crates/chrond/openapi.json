              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add or remove one member (on the leader)",
        "description": "Needs the admin token when the daemon has one. One address per call, from a committed membership: the next generation is persisted on the leader and pushed with its heartbeats, and is committed once a majority of the new membership has persisted it and durably holds everything the leader held when it was made. An added node must be following the leader unless ?force=true. Not committed in time is not an error (committed: false; GET /v1/members says when it is); a second change while one is pending is 409.",
        "parameters": [
          {
            "name": "force",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "add a node that is not following yet"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "add": {
                    "type": "string"
                  },
                  "remove": {
                    "type": "string"
                  }
                },
                "description": "exactly one of add or remove: an advertised address (http://host:port or https://host:port)"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "members": {
                      "type": "object",
                      "properties": {
                        "epoch": {
                          "type": "integer"
                        },
                        "version": {
                          "type": "integer"
                        },
                        "addrs": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "committed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "an error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
