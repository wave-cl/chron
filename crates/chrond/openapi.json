        "summary": "Acknowledge a cursor's progress: next is the position after the last event processed; below the stored next a no-op, past the confirmed bound 400 with the bound in position, from a session that was taken over 412 with the live session in session; unknown cursor 404; leader only",
        "parameters": [
          {
            "name": "db",
            "in": "path",
            "required": true,
            "description": "the database",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "the cursor",
            "schema": {
              "type": "string"
            }
